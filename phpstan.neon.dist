includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon

parameters:
    tmpDir: .cache/phpstan

    # Floor at the lowest supported PHP (composer.json `require.php: ^8.2`).
    # Catches 8.3-only syntax (typed class constants, etc.) at static-analysis
    # time so it doesn't slip past local pest into the CI matrix.
    phpVersion:
        min: 80200
        max: 80499

    stubFiles:
        - .phpstan/stubs/elliptic-php.stub.php

    paths:
        - src
        - tests

    excludePaths:
        - .phpstan/stubs/*

    level: max

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0
        declare: 100

    type_perfect:
        null_over_false: true
        no_mixed: false
        narrow_param: false
        narrow_return: true

    cognitive_complexity:
        class: 80
        function: 20

    strictRules:
        allRules: true

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false

        # Pest internals
        -
            identifier: method.notFound
            path: tests/
            reportUnmatched: false
        -
            identifier: method.internalClass
            path: tests/
            reportUnmatched: false
        -
            identifier: method.nonObject
            path: tests/
            reportUnmatched: false
        -
            identifier: staticMethod.dynamicCall
            path: tests/
            reportUnmatched: false
        -
            identifier: classConstant.internalClass
            path: tests/
            reportUnmatched: false
        # pest-plugin-arch's ArchExpectation interface is marked @internal but
        # the fluent helpers (ignoring, etc.) are the user-facing API.
        -
            identifier: method.internalInterface
            path: tests/Arch/
            reportUnmatched: false
        # Pest arch DSL chains return ArchExpectation; PHPStan can't always
        # follow the fluent return type through ->not->toBeUsed().
        -
            identifier: property.nonObject
            path: tests/Arch/
            reportUnmatched: false
