{
    "name": "sandermuller/php-x402",
    "description": "Framework-agnostic PHP implementation of the x402 payment protocol (HTTP 402 stablecoin settlement).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "x402",
        "http-402",
        "payments",
        "stablecoin",
        "usdc",
        "eip-3009",
        "eip-712",
        "psr-15",
        "psr-18"
    ],
    "homepage": "https://github.com/sandermuller/php-x402",
    "authors": [
        {
            "name": "Sander Muller",
            "email": "sander@hihaho.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^2.0 || ^3.0",
        "psr/log": "^2.0 || ^3.0",
        "kornrunner/keccak": "^1.1",
        "simplito/elliptic-php": "^1.0"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0",
        "rector/type-perfect": "^2.1",
        "spatie/ray": "^1.48",
        "spaze/phpstan-disallowed-calls": "^4.10",
        "symplify/phpstan-extensions": "^12.0",
        "tomasvotruba/cognitive-complexity": "^1.1",
        "tomasvotruba/type-coverage": "^2.1"
    },
    "suggest": {
        "ext-secp256k1": "Native libsecp256k1 binding for ~50x faster signature verification",
        "ext-gmp": "Required for BigInteger math in signature recovery"
    },
    "autoload": {
        "psr-4": {
            "X402\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "X402\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-simplified": "vendor/bin/phpstan analyse --memory-limit=2G --error-format symplify",
        "phpstan-clear-cache": "vendor/bin/phpstan clear-result-cache",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "qa": [
            "@rector",
            "@format",
            "@phpstan-simplified"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
